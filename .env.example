# Existing PostgreSQL container on the external db-network.
# The username, password, and database must match the server's infra stack.
DATABASE_URL=postgresql://openzey:replace_with_server_postgres_password@global-postgres:5432/openzey

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

TRIPI_DOMAIN=tripi.example.com
TRIPI_DASHBOARD_DOMAIN=dashboard.tripi.example.com
TRIPI_CLIENT_DOMAIN=app.tripi.example.com
