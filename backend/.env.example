NODE_ENV=development
PORT=4000
APP_NAME=Tripi
API_PREFIX=api/v1
DATABASE_URL=postgresql://tripi:tripi@localhost:5432/tripi
JWT_ACCESS_SECRET=replace_with_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_another_32_character_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
DASHBOARD_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
MOBILE_DEEP_LINK_SCHEME=tripi
DEFAULT_LOCALE=EN
DEFAULT_CURRENCY=DZD
DEFAULT_TIMEZONE=Africa/Algiers
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000/uploads
MAIL_TRANSPORT=disabled
