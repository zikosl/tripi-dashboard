    "@types/supertest": "^6.0.3",
    "eslint": "^9.31.0",
    "jest": "^30.0.5",
    "prisma": "^7.9.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
